# Backend (server/.env)
EMAIL_AUTH_ENABLED=false
USER_ID_BUSINESS_ENABLED=false
# Unified TEST: enable only after reviewed ownership/index plan. Never sync/drop indexes on original/demo DB.
# Enable only after reviewed partial unique wallet/loginEmail indexes; TEST launcher prepares a fresh DB.
# Google GIS ID-token flow (optional; see docs/GOOGLE_AUTH_SETUP.md).
# Do not enable against an existing database before approved index preparation.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
# GOOGLE_CLIENT_SECRET is not used. Never put secrets in VITE_* variables.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/web3_internship
# Bắt buộc, >= 16 ký tự ngẫu nhiên. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
NONCE_TTL_SECONDS=300
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Bắt buộc để nộp báo cáo / cấp chứng nhận (không có thì API trả 503, không tạo CID giả)
PINATA_JWT=
# Test dùng DB riêng (mặc định web3_internship_test)
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/web3_internship_test
