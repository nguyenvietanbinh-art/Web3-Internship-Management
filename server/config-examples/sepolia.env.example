# Preparation only. This file does not enable existing runtime adapters.
CLOUD_WEB3_NETWORK=sepolia
CLOUD_WEB3_CHAIN_ID=11155111
CLOUD_WEB3_RPC_URL=https://RPC_HOST_FROM_OPERATOR/RPC_PATH
CLOUD_WEB3_RPC_HOST=RPC_HOST_FROM_OPERATOR
CLOUD_WEB3_CONFIRMATIONS=12
CLOUD_WEB3_MANIFEST_FILE=/run/secrets/sepolia-deployment.json
WEB3_LOCAL_ENABLED=false
WEB3_LOCAL_READ_ONLY=true
WEB3_JOURNAL_ENABLED=false
CUSTODIAL_LOCAL_TEST_ENABLED=false
CUSTODIAL_AUTO_ISSUE_ENABLED=false
# Do not put signer/master key values here. Use reviewed secret storage.

# All Cloud activation gates stay disabled for this READ_ONLY release.
CLOUD_WEB3_ENABLED=false
CLOUD_WEB3_WRITE_ENABLED=false
CLOUD_WEB3_SIGNER_ADDRESS=PUBLIC_WRITER_ADDRESS_AFTER_APPROVAL
CLOUD_WEB3_SIGNER_FILE=/etc/secrets/sepolia-signer.key
CLOUD_CUSTODY_ENABLED=false
CLOUD_CUSTODY_WRITE_ENABLED=false
CLOUD_CUSTODY_KEYRING_FILE=/etc/secrets/cloud-custody-keyring.json
CLOUD_SBT_AUTO_ISSUE_ENABLED=false
# CLOUD_SBT_ACTIVATED_AT is supplied only at approved activation, not during READ_ONLY deploy.
